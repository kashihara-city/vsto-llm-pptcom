<Project ToolsVersion="17.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6F2A9D13-5C47-4E8B-B1A0-3D7E92C4F516}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>ChatStreamTests</RootNamespace>
    <AssemblyName>ChatStreamTests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- It compiles OpenAiCompatibleClient.cs for its chat stream only: the chat types it does not use here
         (SlideImage, ChatMessage.Images) are never made or set (CA1812, CS0649). -->
    <NoWarn>$(NoWarn);CA1812;CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- The add-in's own client sources, not copies. No LLM is called: a server on the loopback address
       answers as each test needs. -->
  <ItemGroup>
    <Compile Include="..\..\..\pptcom\Agent\OpenAiCompatibleClient.cs" />
    <Compile Include="..\..\..\pptcom\Agent\StreamedReply.cs" />
    <Compile Include="..\..\..\pptcom\Agent\ChatMessage.cs" />
    <Compile Include="..\..\..\pptcom\Agent\ChatReply.cs" />
    <Compile Include="..\..\..\pptcom\Agent\ToolCall.cs" />
    <Compile Include="..\..\..\pptcom\Agent\SlideImage.cs" />
    <Compile Include="..\..\..\pptcom\Agent\StreamProgress.cs" />
    <Compile Include="..\..\..\pptcom\Agent\LlmServerException.cs" />
    <Compile Include="..\..\..\pptcom\Agent\LlmServerFailure.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\Guard.cs" />
    <Compile Include="..\..\..\pptcom\Polyfills\RequiredMemberAttribute.cs" />
    <Compile Include="..\..\..\pptcom\Polyfills\CompilerFeatureRequiredAttribute.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
