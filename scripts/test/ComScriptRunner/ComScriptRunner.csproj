<Project ToolsVersion="17.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7D2C1F0A-6B7E-4E7A-9C3B-1F2E3D4C5B6A}</ProjectGuid>
    <OutputType>Exe</OutputType>
    <RootNamespace>ComScriptRunner</RootNamespace>
    <AssemblyName>ComScriptRunner</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- The same Office PIAs as the add-in, for the same reason (EnumResolver needs the complete
       assemblies at runtime). -->
  <Import Project="..\..\..\pptcom\OfficePia.props" />

  <!-- The exact ComProxy sources the add-in ships - not a copy - so the experiment measures the
       same parser/engine/policy the add-in actually runs. -->
  <ItemGroup>
    <Compile Include="..\..\..\pptcom\ComProxy\ComOp.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\ComBatchResult.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\ComErrorText.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\DeckProbe.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\EnumResolver.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\ComSecurityPolicy.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\ComProxy.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\ComScriptParser.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\ComScriptScope.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\VbaOps.cs" />
    <Compile Include="..\..\..\pptcom\ComProxy\DeckReader.cs" />
    <Compile Include="..\..\..\pptcom\AddinSettings.cs" />
    <Compile Include="..\..\..\pptcom\Agent\OpenAiCompatibleClient.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
