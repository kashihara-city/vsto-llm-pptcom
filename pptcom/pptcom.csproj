<Project ToolsVersion="17.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <ProjectTypeGuids>{BAA0C2D2-18E2-41B9-852F-F413020CAA33};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3BB54E1A-C992-4016-9421-3403D3A934E2}</ProjectGuid>
    <OutputType>Library</OutputType>
    <NoStandardLibraries>false</NoStandardLibraries>
    <RootNamespace>Pptcom</RootNamespace>
    <AssemblyName>pptcom</AssemblyName>
    <LoadBehavior>3</LoadBehavior>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <DefineConstants>VSTO40;UseOfficeInterop</DefineConstants>
    <BootstrapperEnabled>true</BootstrapperEnabled>
    <BootstrapperComponentsLocation>HomeSite</BootstrapperComponentsLocation>
    <!-- Version of the add-in (VSTO manifests). Keep in step with AssemblyInfo.cs and
         scripts/build/Package.wxs; the release is the MSI built by scripts/build/build.ps1. -->
    <ApplicationVersion>0.0.5.0</ApplicationVersion>
  </PropertyGroup>
  <!-- ClickOnce manifest signing is machine-specific (certificate thumbprint, key file, password), so it lives in
       temp\signing\signing.local.props, which git ignores, next to its test certificate. scripts\build\new-signing.ps1
       makes both. -->
  <PropertyGroup>
    <SigningProps>$(MSBuildThisFileDirectory)..\temp\signing\signing.local.props</SigningProps>
  </PropertyGroup>
  <Import Project="$(SigningProps)" Condition="Exists('$(SigningProps)')" />
  <Target Name="RequireLocalSigning" BeforeTargets="PrepareForBuild" Condition="!Exists('$(SigningProps)')">
    <Error Text="pptcom needs temp\signing\signing.local.props with this machine's ClickOnce signing settings and its test certificate. Make them with: powershell -ExecutionPolicy Bypass -File scripts\build\new-signing.ps1" />
  </Target>

  <ItemGroup>
    <BootstrapperPackage Include=".NETFramework,Version=v4.8">
      <Visible>False</Visible>
      <ProductName>Microsoft .NET Framework 4.8 %28x86 and x64%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
    <BootstrapperPackage Include="Microsoft.VSTORuntime.4.0">
      <Visible>False</Visible>
      <ProductName>Microsoft Visual Studio 2010 Tools for Office Runtime %28x86 and x64%29</ProductName>
      <Install>true</Install>
    </BootstrapperPackage>
  </ItemGroup>

  <PropertyGroup>
    <OfficeApplication>PowerPoint</OfficeApplication>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(BaseOutputPath)Debug\</OutputPath>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(BaseOutputPath)Release\</OutputPath>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- The task pane is HTML in a WebView2 (UI\web\). Uses the WebView2 Runtime installed
         on the PC; this package is the SDK (Core and WinForms DLLs, and the native WebView2Loader). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Accessibility" />
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Core"/>
    <Reference Include="System.Xml.Linq"/>
    <Reference Include="System.Data.DataSetExtensions"/>
    <Reference Include="System.Net.Http"/>
    <Reference Include="Microsoft.CSharp"/>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Office.Tools.v4.0.Framework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Tools.Applications.Runtime, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.Common, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Office.Tools.Common.v4.0.Utilities, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <!-- The Office 2013 PIAs, complete and copied next to the add-in: see OfficePia.props. -->
  <PropertyGroup>
    <!-- Not shipped: PowerPoint uses the PIAs Office installed in the GAC (see OfficePia.props). -->
    <OfficePiaCopyLocal>False</OfficePiaCopyLocal>
  </PropertyGroup>
  <Import Project="OfficePia.props" />
  <!-- Newtonsoft.Json and the WebView2 SDK merged into pptcom.dll: see MergeDependencies.targets. -->
  <Import Project="MergeDependencies.targets" />
  <!-- The task pane's third-party scripts (anydoc, PDF.js) embedded in pptcom.dll: see WebVendor.targets. -->
  <Import Project="WebVendor.targets" />
  <!-- The commit pptcom.dll is built from, for BuildInfo: see CommitInfo.targets. -->
  <Import Project="CommitInfo.targets" />

  <ItemGroup>
    <Reference Include="stdole, Version=7.0.3300.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a">
      <Private>False</Private>
    </Reference>
  </ItemGroup>

