<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    The commit pptcom.dll is built from, as [assembly: AssemblyMetadata("Commit", "5efe257")] in a generated
    source file (BuildInfo reads it): "5efe257+" when tracked files had changes that were not committed, "unknown"
    when git cannot tell (no git, not a clone). The version stays where it is (Properties\AssemblyInfo.cs).
    The file is rewritten only when the commit changes, so a build with nothing new compiles nothing.
  -->
  <Target Name="WriteCommitInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_CommitInfoFile>$(IntermediateOutputPath)CommitInfo.g.cs</_CommitInfoFile>
    </PropertyGroup>
    <!-- git writes "fatal: ..." on stderr outside a clone: only the exit code counts (IgnoreStandardErrorWarningFormat). -->
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommitHash" />
      <Output TaskParameter="ExitCode" PropertyName="_CommitHashExit" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildThisFileDirectory)" ConsoleToMSBuild="true"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low"
          Condition="'$(_CommitHashExit)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="_CommitChanges" />
    </Exec>
    <PropertyGroup>
      <_Commit Condition="'$(_CommitHashExit)' == '0'">$(_CommitHash.Trim())</_Commit>
      <_Commit Condition="'$(_Commit)' != '' and '$(_CommitChanges)' != ''">$(_Commit)+</_Commit>
      <_Commit Condition="'$(_Commit)' == ''">unknown</_Commit>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CommitInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="// Generated by CommitInfo.targets.;[assembly: System.Reflection.AssemblyMetadata(&quot;Commit&quot;, &quot;$(_Commit)&quot;)]" />
    <ItemGroup>
      <Compile Include="$(_CommitInfoFile)" />
      <FileWrites Include="$(_CommitInfoFile)" />
    </ItemGroup>
  </Target>
</Project>
