# ---------------------------------------------------------------------------
# vsto-llm-pptcom リポジトリ用
# 各項目の上に「なぜ除外するか」を書いている。除外をやめるときは理由も消すこと。
# ---------------------------------------------------------------------------

# 手元の資料。開発環境の話や作業する人向けの話が多いので、リポジトリには入れない。リポジトリ向けの説明は README に書く。
notes/

# 過去の試作と旧方式の実験の置き場。今の製品とリグは参照していない。
old/

# 配布用の MSI（release/vsto-llm-pptcom-<版>.msi）。scripts/build/build.ps1 で作り直せる上、
# 開発機の証明書で署名済みのバイナリと、その公開鍵を含むので入れない。
release/

# 開発機で作るもの。消してもよいが、開発中は残しておく。
#   temp/build/    ビルドの出力（各プロジェクトの bin と obj。Directory.Build.props）。ソースから MSBuild で作り直せる。
#   temp/signing/  ClickOnce の署名の設定（signing.local.props: 証明書の拇印、鍵のファイル、パスワード）と、
#                  その自己署名のテスト証明書（秘密鍵を含む）。開発機ごとに違う。無いとビルドは理由を表示して止まり、
#                  scripts/build/new-signing.ps1 で作り直せる。
temp/

# 秘密鍵を含む証明書。temp/signing/ の外に置かれても入れない。
*.pfx
